{
	"description": "HTML matrix of PHP builds in ppa:ondrej/php and deb.sury.org/php",
	"require": {
		"php": ">=8.5",
		"ext-curl": "*",
		"ext-zlib": "*"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^4.0.4"
	},
	"scripts": {
		"lint": "phpcs",
		"fix": "phpcbf"
	},
	"config": {
		"sort-packages": true
	}
}
